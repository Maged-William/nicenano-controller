source "Kconfig.zephyr"

menu "Gyro Mouse Configuration"

config GYRO_MOUSE_ENABLE
	bool "Enable gyro mouse"
	default y
	help
	  Master enable for gyro-controlled mouse cursor.

config GYRO_MOUSE_X_SOURCE
	int "Gyro axis for mouse X (0=X, 1=Y, 2=Z)"
	default 0
	range 0 2
	help
	  0=gyro X, 1=gyro Y, 2=gyro Z.

config GYRO_MOUSE_X_INVERT
	bool "Invert mouse X axis"
	default n

config GYRO_MOUSE_Y_SOURCE
	int "Gyro axis for mouse Y (0=X, 1=Y, 2=Z)"
	default 1
	range 0 2

config GYRO_MOUSE_Y_INVERT
	bool "Invert mouse Y axis"
	default n

menu "Sensor Hardware"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_SPI_FREQ
	int "SPI bus frequency (Hz)"
	default 8000000
	range 1000000 8000000

config GYRO_MOUSE_CS1_PIN
	int "Sensor 1 chip-select pin"
	default 31
	range 0 31

config GYRO_MOUSE_CS2_PIN
	int "Sensor 2 chip-select pin"
	default 29
	range 0 31

config GYRO_MOUSE_S1_RANGE
	int "Sensor 1 gyro range (dps)"
	default 500
	range 125 2000
	help
	  Options: 125, 250, 500, 1000, 2000.

config GYRO_MOUSE_S2_RANGE
	int "Sensor 2 gyro range (dps)"
	default 125
	range 125 2000

config GYRO_MOUSE_ODR
	int "Gyro/Accel output data rate (Hz)"
	default 1600
	range 25 1600
	help
	  Options: 25, 50, 100, 200, 400, 800, 1600.

endmenu

menu "Sampling & Timing"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_BURST_HIGH
	int "Burst samples/tick for high-range sensor"
	default 16
	range 1 256

config GYRO_MOUSE_BURST_LOW
	int "Burst samples/tick for low-range sensor"
	default 112
	range 1 256

config GYRO_MOUSE_TICK_PERIOD_MS
	int "Main loop period (ms)"
	default 4
	range 1 100
	help
	  4ms = 250Hz, 10ms = 100Hz.

endmenu

menu "Mouse Sensitivity"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_SENSITIVITY_NUM
	int "Sensitivity numerator"
	default 1
	range 1 10000
	help
	  Effective sensitivity = NUM / DENOM.  1/1000 = 0.001.

config GYRO_MOUSE_SENSITIVITY_DENOM
	int "Sensitivity denominator"
	default 1000
	range 1 10000

config GYRO_MOUSE_DEADZONE
	int "Accumulation deadzone threshold (x1000)"
	default 500
	range 0 2000
	help
	  500 = 0.5 pixels. Prevents drift from accumulated noise.

endmenu

menu "Filters"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_HSSNF_ENABLE
	bool "Enable HSSNF non-linear filter"
	default y

config GYRO_MOUSE_HSSNF_T
	int "HSSNF threshold t (x1000)"
	default 1000
	range 1 2000
	depends on GYRO_MOUSE_HSSNF_ENABLE

config GYRO_MOUSE_HSSNF_K
	int "HSSNF curve k (x1000)"
	default 500
	range 1 999
	depends on GYRO_MOUSE_HSSNF_ENABLE

config GYRO_MOUSE_CROSSFADE_Z
	int "Crossfade ramp_mid z (x1000)"
	default 200
	range 50 450
	help
	  200 = 0.2. Deadzone width in saturation-weighted crossfade.

endmenu

menu "Calibration"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_CALIBRATE_ON_BOOT
	bool "Calibrate gyro offsets on every boot"
	default y

config GYRO_MOUSE_CAL_SAMPLES
	int "Calibration sample count"
	default 500
	range 100 5000
	depends on GYRO_MOUSE_CALIBRATE_ON_BOOT

config GYRO_MOUSE_HARDCODED_CAL
	bool "Use hardcoded calibration offsets (skip auto-cal)"
	default n

if GYRO_MOUSE_HARDCODED_CAL

config GYRO_MOUSE_CAL_S1X
	int "Sensor 1 (500dps) gyro X offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S1Y
	int "Sensor 1 gyro Y offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S1Z
	int "Sensor 1 gyro Z offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S2X
	int "Sensor 2 (125dps) gyro X offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S2Y
	int "Sensor 2 gyro Y offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S2Z
	int "Sensor 2 gyro Z offset"
	default 0
	range -32768 32767

endif

endmenu

menu "Debug"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_ADC_DECIMATION
	int "ADC read interval (ticks)"
	default 25
	range 1 1000
	help
	  25 ticks at 250Hz = 10Hz debug serial output.

config GYRO_MOUSE_LED_DECIMATION
	int "LED toggle interval (ticks)"
	default 100
	range 1 10000

config GYRO_MOUSE_DTR_TIMEOUT_MS
	int "DTR serial wait timeout (ms). 0 = boot immediately"
	default 0
	range 0 30000
	help
	  0:   Start HID mouse immediately. Serial debug lost until terminal opens.
	  >0:  Wait up to N ms for a terminal to connect before proceeding.

endmenu

menu "TPS43 Touchpad"

config TPS43_ENABLE
	bool "Enable TPS43 touchpad"
	default y
	help
	  Master enable for Azoteq TPS43 capacitive touchpad on I2C (addr 0x74).

config TPS43_SENSITIVITY_NUM
	int "Touchpad sensitivity numerator"
	default 12
	range 1 100
	depends on TPS43_ENABLE
	help
	  Effective sensitivity = NUM / DENOM. Raw touchpad delta is multiplied
	  by this factor before adding to the mouse accumulator. 12/2 = 6x.

config TPS43_SENSITIVITY_DENOM
	int "Touchpad sensitivity denominator"
	default 2
	range 1 100
	depends on TPS43_ENABLE

config TPS43_SCROLL_SENS_NUM
	int "Scroll sensitivity numerator"
	default 2
	range 1 100
	depends on TPS43_ENABLE
	help
	  Effective scroll sensitivity = NUM / DENOM. 2/1 = 2x.

config TPS43_SCROLL_SENS_DENOM
	int "Scroll sensitivity denominator"
	default 1
	range 1 100
	depends on TPS43_ENABLE

config TPS43_INVERT_X
	bool "Invert touchpad X axis"
	default n
	depends on TPS43_ENABLE

config TPS43_INVERT_Y
	bool "Invert touchpad Y axis"
	default n
	depends on TPS43_ENABLE

config TPS43_TAP_ENABLE
	bool "Enable tap-to-click"
	default y
	depends on TPS43_ENABLE
	help
	  When enabled, a tap gesture on the touchpad sends left mouse button click.

menu "Tap-and-Drag"
	depends on TPS43_ENABLE

config TPS43_TAPDRAG_ENABLE
	bool "Enable tap-and-drag with drag lock"
	default n
	help
	  Software FSM replaces hardware tap-to-click (TPS43_TAP_ENABLE is
	  ignored when this is active). Provides tap-and-drag with drag lock:
	  lift and re-touch within the timeout to continue dragging.

config TPS43_TAP_MOVE_THRESH
	int "Tap movement threshold (abs counts)"
	default 120
	range 1 1000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  Maximum finger movement (in absolute-position counts) during a touch
	  for it to still be considered a tap. Larger = more tolerant.

config TPS43_SAME_SPOT_THRESH
	int "Re-touch distance threshold (abs counts)"
	default 300
	range 1 1000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  How close the re-touch must land to the tap-up position (in absolute
	  counts) to arm the drag. Larger = easier to re-arm.

config TPS43_TAP_MAX_TIME
	int "Tap max hold time (ms)"
	default 300
	range 10 1000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  Maximum finger-down duration for a touch to count as a tap.
	  Longer than this and it's treated as a press/move.

config TPS43_REDOWN_WINDOW
	int "Tap re-touch window (ms)"
	default 600
	range 10 2000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  Timer1: how long the user has to re-touch after a tap to arm a drag.
	  libinput default: 500ms.

config TPS43_CONFIRM_WINDOW
	int "Drag confirm window (ms)"
	default 150
	range 0 1000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  Timer2: if the finger moves within this window after re-touching,
	  the drag is confirmed (button stays held). If the finger moves
	  AFTER this window, the button is released and it becomes a normal
	  pointer move. Set to 0 to disable and always confirm on any move.

config TPS43_DRAG_LOCK_TIMEOUT
	int "Drag lock timeout (ms)"
	default 800
	range 10 2000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  Timer3: how long the user has to re-touch after lifting mid-drag
	  to continue dragging without releasing the button.

endmenu

config TPS43_DEBUG
	bool "Print touchpad register dump on every tick"
	default n
	depends on TPS43_ENABLE
	help
	  Prints all 16 register bytes from the TPS43 for debugging.

endmenu

endmenu
