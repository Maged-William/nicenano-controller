	int "Sensor 1 gyro Z offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S2X
	int "Sensor 2 (125dps) gyro X offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S2Y
	int "Sensor 2 gyro Y offset"
	default 0
	range -32768 32767
config GYRO_MOUSE_CAL_S2Z
	int "Sensor 2 gyro Z offset"
	default 0
	range -32768 32767

endif

endmenu

menu "Debug"
	depends on GYRO_MOUSE_ENABLE

config GYRO_MOUSE_ADC_DECIMATION
	int "ADC read interval (ticks)"
	default 25
	range 1 1000
	help
	  25 ticks at 250Hz = 10Hz debug serial output.

config GYRO_MOUSE_LED_DECIMATION
	int "LED toggle interval (ticks)"
	default 100
	range 1 10000

config GYRO_MOUSE_DTR_TIMEOUT_MS
	int "DTR serial wait timeout (ms). 0 = boot immediately"
	default 0
	range 0 30000
	help
	  0:   Start HID mouse immediately. Serial debug lost until terminal opens.
	  >0:  Wait up to N ms for a terminal to connect before proceeding.

endmenu

menu "TPS43 Touchpad"

config TPS43_ENABLE
	bool "Enable TPS43 touchpad"
	default y
	help
	  Master enable for Azoteq TPS43 capacitive touchpad on I2C (addr 0x74).

config TPS43_SENSITIVITY_NUM
	int "Touchpad sensitivity numerator"
	default 1
	range 1 100
	depends on TPS43_ENABLE
	help
	  Effective sensitivity = NUM / DENOM. Raw touchpad delta is multiplied
	  by this factor before adding to the mouse accumulator. 1/1 = 1x.

config TPS43_SENSITIVITY_DENOM
	int "Touchpad sensitivity denominator"
	default 1
	range 1 100
	depends on TPS43_ENABLE

config TPS43_SCROLL_SENS_NUM
	int "Scroll sensitivity numerator"
	default 2
	range 1 100
	depends on TPS43_ENABLE
	help
	  Effective scroll sensitivity = NUM / DENOM. 2/1 = 2x.

config TPS43_SCROLL_SENS_DENOM
	int "Scroll sensitivity denominator"
	default 1
	range 1 100
	depends on TPS43_ENABLE

config TPS43_INVERT_X
	bool "Invert touchpad X axis"
	default n
	depends on TPS43_ENABLE

config TPS43_INVERT_Y
	bool "Invert touchpad Y axis"
	default n
	depends on TPS43_ENABLE

config TPS43_TAP_ENABLE
	bool "Enable tap-to-click"
	default y
	depends on TPS43_ENABLE
	help
	  When enabled, a tap gesture on the touchpad sends left mouse button click.

menu "Soft-Tap FSM (Exp13)"
	depends on TPS43_ENABLE

config TPS43_TAPDRAG_ENABLE
	bool "Enable soft-tap FSM (libinput-style)"
	default y
	help
	  Pure-software tap FSM ported from libinput's evdev-mt-touchpad-tap.c.
	  Requires TPS43 gesture engine to be disabled (SFGestureEnable=0) so
	  that FINGER_COUNT stays stable. Replaces CONFIG_TPS43_TAP_ENABLE.

config TPS43_TAP_TIMEOUT_MS
	int "Tap detection timeout (ms)"
	default 180
	range 50 500
	depends on TPS43_TAPDRAG_ENABLE
	help
	  libinput default: 180ms. Maximum finger-down time to qualify as a tap.
	  Longer = more forgiving of slow taps, but finger-down + hold may
	  accidentally trigger a tap on release.

config TPS43_DOUBLE_CLICK_TIMEOUT_MS
	int "Double-click / re-touch window (ms)"
	default 250
	range 50 500
	depends on TPS43_TAPDRAG_ENABLE
	help
	  After a tap, the window during which a second touch is accepted.
	  If the second touch releases quickly (within TAP_TIMEOUT_MS):
	    → double-click.
	  If the second touch holds or moves:
	    → drag start.
	  Longer = more forgiving of slow double-taps, but drag feels
	  delayed. Shorter = snappier but may miss slow double-taps.

config TPS43_DRAGLOCK_ENABLE
	bool "Enable drag lock (lift & re-touch to continue drag)"
	default n
	depends on TPS43_TAPDRAG_ENABLE
	help
	  When enabled, lifting the finger mid-drag keeps the button held
	  for DRAGLOCK_TIMEOUT_MS. Re-touching within that window continues
	  the drag without releasing. Disabled = instant drop on lift.

config TPS43_DRAGLOCK_TIMEOUT_MS
	int "Drag lock re-touch window (ms)"
	default 300
	range 50 1000
	depends on TPS43_TAPDRAG_ENABLE
	help
	  libinput default: 300ms. While dragging, if the finger lifts,
	  this is how long the user has to touch down again to continue
	  dragging without releasing the button.

config TPS43_TAP_MOVE_THRESH
	int "Tap movement threshold (abs counts)"
	default 30
	range 5 500
	depends on TPS43_TAPDRAG_ENABLE
	help
	  libinput default: 1.3mm (~30 TPS43 abs units).
	  Maximum finger movement during a touch for it to still count as a tap.
	  Larger = more tolerant of finger wiggle.

config TPS43_SAME_SPOT_THRESH
	int "Re-touch same-spot threshold (abs counts)"
	default 80
	range 5 500
	depends on TPS43_TAPDRAG_ENABLE
	help
	  How close the re-touch must land to the tap-up position to qualify
	  as a drag continuation (rather than a new tap). Larger = easier to
	  re-arm drag.

config TPS43_DROP_GRACE_MS
	int "Drop grace period (ms)"
	default 20
	range 0 200
	depends on TPS43_TAPDRAG_ENABLE
	help
	  When dragging, the finger may briefly lose contact with the touchpad
	  (transient). This grace period keeps the drag button held while waiting
	  for the finger to return. 0 = disabled (instant drop on release).

endmenu

menu "1-Finger Edge Scroll (Exp15)"
	depends on TPS43_ENABLE

config TPS43_EDGESCROLL_ENABLE
	bool "Enable 1-finger edge scroll"
	default n
	help
	  Right edge → vertical scroll, bottom edge → horizontal scroll.
	  Uses absolute finger position from the TPS43 sensor.

if TPS43_EDGESCROLL_ENABLE

config TPS43_ABS_MAX_X
	int "Touchpad absolute X max value"
	default 65535
	range 1 65535
	help
	  Maximum absolute X value the touchpad can report.
	  Adjust to match your touchpad's actual resolution
	  (e.g., 1024 for a 1024-unit wide touchpad).

config TPS43_ABS_MAX_Y
	int "Touchpad absolute Y max value"
	default 65535
	range 1 65535
	help
	  Maximum absolute Y value the touchpad can report.

config TPS43_EDGE_RIGHT_PCT
	int "Right edge zone width (%)"
	default 10
	range 3 50
	help
	  Percentage from the right edge where vertical scroll activates.

config TPS43_EDGE_BOTTOM_PCT
	int "Bottom edge zone height (%)"
	default 10
	range 3 50
	help
	  Percentage from the bottom edge where horizontal scroll activates.

endif
endmenu

config TPS43_DEBUG
	bool "Print touchpad register dump on every tick"
	default n
	depends on TPS43_ENABLE
	help
	  Prints all 16 register bytes from the TPS43 for debugging.

endmenu

endmenu
